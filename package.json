{
  "name": "margincarry",
  "version": "0.1.0",
  "private": true,
  "description": "Review and transfer native annotations between PDF revisions in Zotero Desktop",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "check": "biome check --error-on-warnings . && npm run typecheck && npm test && npm run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
