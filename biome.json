{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!validation", "!!package-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/zotero.ts", "src/host.d.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["bootstrap.js"],
      "javascript": {
        "globals": ["Zotero", "Cc", "Ci", "Services"]
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/host/*.js"],
      "javascript": {
        "globals": [
          "Zotero",
          "Services",
          "IOUtils",
          "PathUtils",
          "ChromeUtils",
          "Cu",
          "Cc",
          "Ci",
          "hostRoot",
          "hostValidationRoot",
          "hostValidationAction",
          "hostValidationReportRoot"
        ]
      }
    }
  ]
}
